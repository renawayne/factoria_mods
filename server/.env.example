# Copy values into Portainer Stack environment variables.
SERVER_PORT=34197

# Required only if the server must download enabled official Mod Portal mods.
UPDATE_MODS_ON_START=false
FACTORIO_USERNAME=
FACTORIO_TOKEN=

# Optional: comma-separated Factorio mod names to ignore in official updater.
# GitHub-managed mod names are appended automatically.
UPDATE_IGNORE=
